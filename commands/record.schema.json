{
	"$comment": "GENERATED from nexus/packages/record/schema.ts. Do not edit. Run `npx tsx nexus/scripts/build-record-schema.mjs` and commit the result.",
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"title": "pratiq audit record",
	"type": "object",
	"properties": {
		"schemaVersion": {
			"const": 1
		},
		"skill": {
			"type": "string",
			"minLength": 1
		},
		"certifications": {
			"type": "array",
			"items": {
				"type": "object",
				"properties": {
					"criterion": {
						"enum": [
							"safe-to-load",
							"safe-to-execute",
							"house-style"
						]
					},
					"state": {
						"enum": [
							"certified",
							"refused",
							"not-applicable",
							"not-assessed"
						]
					},
					"by": {
						"anyOf": [
							{
								"type": "string",
								"minLength": 1
							},
							{
								"type": "null"
							}
						]
					},
					"on": {
						"anyOf": [
							{
								"type": "string",
								"pattern": "^\\d{4}-\\d{2}-\\d{2}$"
							},
							{
								"type": "null"
							}
						]
					},
					"method": {
						"anyOf": [
							{
								"type": "string",
								"minLength": 1
							},
							{
								"type": "null"
							}
						]
					},
					"inventoryDigest": {
						"anyOf": [
							{
								"type": "string",
								"pattern": "^sha256:[0-9a-f]{64}$"
							},
							{
								"type": "null"
							}
						]
					},
					"why": {
						"anyOf": [
							{
								"type": "string",
								"minLength": 1
							},
							{
								"type": "null"
							}
						]
					}
				},
				"required": [
					"criterion",
					"state",
					"by",
					"on",
					"method",
					"inventoryDigest",
					"why"
				],
				"additionalProperties": false
			},
			"minItems": 1
		},
		"inventory": {
			"type": "object",
			"additionalProperties": {
				"type": "string",
				"pattern": "^sha256:[0-9a-f]{64}$"
			}
		},
		"findings": {
			"type": "array",
			"items": {
				"type": "object",
				"properties": {
					"code": {
						"type": "string",
						"minLength": 1
					},
					"severity": {
						"enum": [
							"block",
							"review",
							"note"
						]
					},
					"at": {
						"type": "string",
						"minLength": 1
					},
					"excerpt": {
						"type": "string"
					},
					"disposition": {
						"enum": [
							"real",
							"accepted",
							"false-positive",
							"fixed",
							"removed",
							"not-applicable"
						]
					},
					"why": {
						"type": "string",
						"minLength": 1
					}
				},
				"required": [
					"code",
					"severity",
					"at",
					"excerpt",
					"disposition",
					"why"
				],
				"additionalProperties": false
			}
		},
		"notChecked": {
			"type": "array",
			"items": {
				"type": "string",
				"minLength": 1
			}
		},
		"exemption": {
			"anyOf": [
				{
					"type": "object",
					"properties": {
						"reason": {
							"type": "string",
							"minLength": 1
						},
						"on": {
							"type": "string",
							"pattern": "^\\d{4}-\\d{2}-\\d{2}$"
						}
					},
					"required": [
						"reason",
						"on"
					],
					"additionalProperties": false
				},
				{
					"type": "null"
				}
			]
		},
		"provenance": {
			"type": "object",
			"properties": {
				"source": {
					"anyOf": [
						{
							"type": "string"
						},
						{
							"type": "null"
						}
					]
				},
				"commit": {
					"anyOf": [
						{
							"type": "string"
						},
						{
							"type": "null"
						}
					]
				},
				"retrieved": {
					"anyOf": [
						{
							"type": "string"
						},
						{
							"type": "null"
						}
					]
				},
				"license": {
					"anyOf": [
						{
							"type": "string"
						},
						{
							"type": "null"
						}
					]
				},
				"licenseBasis": {
					"anyOf": [
						{
							"type": "string"
						},
						{
							"type": "null"
						}
					]
				}
			},
			"required": [
				"source",
				"commit",
				"retrieved",
				"license",
				"licenseBasis"
			],
			"additionalProperties": false
		}
	},
	"required": [
		"schemaVersion",
		"skill",
		"certifications",
		"inventory",
		"findings",
		"notChecked",
		"exemption",
		"provenance"
	],
	"additionalProperties": false
}
