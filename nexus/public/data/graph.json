    {
      "kind": "skill",
      "id": "skill-audit",
      "name": "skill-audit",
      "description": "Audit a third-party skill before adopting it — prompt injection, hidden instructions, unsafe scripts, permission grabs — then judge it against house authoring standards and produce an adoption report. Use when a skill has been pasted, downloaded, copied from a repo or gist, or found online and needs vetting; when asking whether a skill is safe to install; when reviewing a SKILL.md from someone else; or when deciding whether to adopt, revise or reject an incoming skill. Reports only — it never edits the skill.",
      "category": "trust",
      "origin": "authored",
