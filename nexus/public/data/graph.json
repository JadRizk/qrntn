    {
      "kind": "skill",
      "id": "design-direction",
      "name": "design-direction",
      "description": "Define the direction of a design system or brand before any code exists \u2014 thesis, voice, palette, type and form \u2014 validating every colour decision by computation rather than eye. Use when starting a design system from scratch, choosing an accent, deriving status or chart colours, checking contrast and colour-blind separation, setting a type scale, or writing a BRAND.md. Produces BRAND.md and PALETTE.md, the two documents an implementation reads. Stack-agnostic.",
      "category": "direction",
      "origin": "authored",
