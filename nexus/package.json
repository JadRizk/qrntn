{
  "name": "nexus",
  "private": true,
  "type": "module",
  "scripts": {
    "export:data": "tsx scripts/export-graph.mjs",
    "check": "tsx scripts/check-graph.mjs",
    "check:strict": "tsx scripts/check-graph.mjs --strict",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "typecheck:graph": "tsc --noEmit -p packages/graph/tsconfig.json",
    "verify": "npm run typecheck && npm run typecheck:graph && npm run test && npm run check:strict",
    "dev": "vite",
    "build": "vite build",
    "build:cli": "node scripts/build-view.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.170.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@types/three": "^0.170.0",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "0.28.2",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  }
}
